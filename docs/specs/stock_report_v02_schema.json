{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StockReport_v0.2",
  "type": "object",
  "required": [
    "report_version",
    "ticker",
    "name",
    "market",
    "asset_type",
    "requested_as_of",
    "reference_market_date",
    "header",
    "summary",
    "current_snapshot",
    "a_fast_core",
    "pattern_a_fast",
    "monthly_history",
    "foreign_flow",
    "trading_value_flow",
    "data_quality",
    "provenance"
  ],
  "properties": {
    "report_version": { "type": "string", "enum": ["0.2"] },
    "ticker": { "type": "string", "pattern": "^[0-9A-Z]{6}$" },
    "name": { "type": "string" },
    "market": { "type": "string", "enum": ["KOSPI", "KOSDAQ", "KONEX", "UNKNOWN"] },
    "asset_type": { "type": "string", "enum": ["COMMON", "PREFERRED", "SPAC", "REIT", "ETF", "ETN", "OTHER", "UNKNOWN"] },
    "requested_as_of": { "type": "string" },
    "reference_market_date": { "type": "string" },
    
    "header": {
      "type": "object",
      "required": ["ticker", "name", "market", "asset_type", "requested_as_of", "reference_market_date", "cache_present", "report_status"],
      "properties": {
        "ticker": { "type": "string", "pattern": "^[0-9A-Z]{6}$" },
        "name": { "type": "string" },
        "market": { "type": "string", "enum": ["KOSPI", "KOSDAQ", "KONEX", "UNKNOWN"] },
        "asset_type": { "type": "string", "enum": ["COMMON", "PREFERRED", "SPAC", "REIT", "ETF", "ETN", "OTHER", "UNKNOWN"] },
        "requested_as_of": { "type": "string" },
        "reference_market_date": { "type": "string" },
        "effective_as_of": { "type": ["string", "null"] },
        "cache_present": { "type": "boolean" },
        "cache_last_date": { "type": ["string", "null"] },
        "report_status": { "type": "string", "enum": ["READY", "PARTIAL", "DATA_UNAVAILABLE"] }
      }
    },
    
    "summary": {
      "type": "object",
      "required": ["headline", "bullet_points", "combined_narrative"],
      "properties": {
        "headline": { "type": "string" },
        "strategy_headline": { "type": ["string", "null"] },
        "bullet_points": { "type": "array", "items": { "type": "string" } },
        "combined_narrative": { "type": "string" }
      }
    },
    
    "current_snapshot": {
      "type": "object",
      "required": ["official_stage", "candidate_state", "is_candidate", "investability_status", "investability_reason", "is_investable"],
      "properties": {
        "pattern_a_score": { "type": ["number", "null"] },
        "official_stage": { "type": "string" },
        "candidate_state": { "type": "string" },
        "is_candidate": { "type": "boolean" },
        "market_cap_eok": { "type": ["number", "null"] },
        "avg_trading_value_20d_eok": { "type": ["number", "null"] },
        "investability_status": { "type": "string" },
        "investability_reason": { "type": "string" },
        "is_investable": { "type": "boolean" }
      }
    },
    
    "a_fast_core": {
      "type": "object",
      "required": [
        "strategy_id",
        "strategy_version",
        "strategy_alias",
        "strategy_status",
        "production_status",
        "fresh_oos_status",
        "as_of",
        "applicability",
        "strategy_state",
        "canonical_position",
        "action",
        "action_reason",
        "interpretation",
        "provenance"
      ],
      "properties": {
        "strategy_id": { "type": "string", "enum": ["PATTERN_A_FAST_FINAL_STRATEGY_V02"] },
        "strategy_version": { "type": "string", "enum": ["V02"] },
        "strategy_alias": { "type": "string" },
        "strategy_status": { "type": "string" },
        "production_status": { "type": "string" },
        "fresh_oos_status": { "type": "string" },
        "as_of": { "type": "string" },
        "applicability": { "type": "string", "enum": ["APPLICABLE", "NOT_APPLICABLE", "DATA_UNAVAILABLE"] },
        "strategy_state": { "type": "string", "enum": ["HOLD_PROGRESSED", "HOLD_PRE_PROGRESSED", "ENTRY", "EXIT", "WAIT", "NOT_APPLICABLE", "DATA_UNAVAILABLE"] },
        "canonical_position": { "type": "string", "enum": ["OPEN", "FLAT", "NOT_APPLICABLE", "DATA_UNAVAILABLE"] },
        "action": { "type": "string", "enum": ["HOLD", "ENTER_NEXT_OPEN", "EXIT_NEXT_OPEN", "WAIT", "NONE"] },
        "action_reason": { "type": "string" },
        "execution_timing": { "type": ["string", "null"] },
        "interpretation": { "type": "string" }
      }
    },
    
    "pattern_a_fast": {
      "type": "object",
      "required": ["contract", "label", "lifecycle_status", "history_start_as_of", "history_end_as_of", "observation_count", "weekly_history"],
      "properties": {
        "contract": { "type": "string" },
        "label": { "type": "string" },
        "lifecycle_status": { "type": "string" },
        "history_start_as_of": { "type": ["string", "null"] },
        "history_end_as_of": { "type": ["string", "null"] },
        "observation_count": { "type": "integer" },
        "weekly_history": { "type": "array" }
      }
    },
    
    "monthly_history": {
      "type": "object",
      "required": ["history_start_as_of", "history_end_as_of", "observation_count", "recent_12m_observation_count", "full_monthly_history", "recent_12m_history", "first_pattern_a_available_as_of", "pattern_a_available_observation_count", "stage_transitions", "score_trend"],
      "properties": {
        "history_start_as_of": { "type": ["string", "null"] },
        "history_end_as_of": { "type": ["string", "null"] },
        "observation_count": { "type": "integer" },
        "recent_12m_observation_count": { "type": "integer" },
        "full_monthly_history": { "type": "array" },
        "recent_12m_history": { "type": "array" },
        "first_pattern_a_available_as_of": { "type": ["string", "null"] },
        "pattern_a_available_observation_count": { "type": "integer" }
      }
    },
    
    "foreign_flow": {
      "type": "object",
      "required": ["data_status", "flow_state", "explanation"],
      "properties": {
        "data_status": { "type": "string" },
        "flow_state": { "type": "string" },
        "explanation": { "type": "string" }
      }
    },
    
    "trading_value_flow": {
      "type": "object",
      "required": ["trading_value_state", "explanation"],
      "properties": {
        "trading_value_state": { "type": "string" },
        "explanation": { "type": "string" }
      }
    },
    
    "data_quality": {
      "type": "object",
      "required": ["cache_present", "daily_rows_count", "completed_month_count", "quality_status"],
      "properties": {
        "cache_present": { "type": "boolean" },
        "cache_first_date": { "type": ["string", "null"] },
        "cache_last_date": { "type": ["string", "null"] },
        "daily_rows_count": { "type": "integer" },
        "completed_month_count": { "type": "integer" },
        "quality_status": { "type": "string" }
      }
    },
    
    "provenance": {
      "type": "object",
      "required": ["stock_price_source", "score_contract", "stage_contract", "investability_contract", "foreign_flow_contract", "network_requests"],
      "properties": {
        "stock_price_source": { "type": "string" },
        "score_contract": { "type": "string" },
        "stage_contract": { "type": "string" },
        "investability_contract": { "type": "string" },
        "foreign_flow_contract": { "type": "string" },
        "network_requests": { "type": "integer", "enum": [0] }
      }
    }
  }
}
